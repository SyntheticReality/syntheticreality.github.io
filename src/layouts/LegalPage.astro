---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/ggc.css";

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    productName?: string;
    heading?: string;
    headingAccent?: string;
  };
}

const { frontmatter } = Astro.props;
const {
  title = "Privacy Policy",
  description = "Privacy and data-use information for OSYRYS services.",
  productName = "Galactic Gorilla Corps",
  heading = "Privacy",
  headingAccent = "Policy",
} = frontmatter;

const isTerms = Astro.url.pathname.includes("ggc-tou");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image="/ggc/og.jpg"
      colorScheme="dark"
    />
    <meta name="theme-color" content="#03090f" />
    <link
      rel="preload"
      href="/fonts/ggc/Oxanium.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/webp" href="/ggc/icon.webp" />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a class="ggc-skip-link" href="#legal-content">Skip to legal content</a>
    <Header />

    <main class="ggc-theme ggc-legal-page">
      <header class="ggc-legal-masthead">
        <div class="ggc-shell">
          <a class="ggc-back-link" href="/ggc">Back to Galactic Gorilla Corps</a>

          <div class="ggc-legal-masthead__content">
            <div>
              <p class="ggc-kicker">{productName}</p>
              <h1>
                {heading}
                <span>{headingAccent}</span>
              </h1>
            </div>
            <p>{description}</p>
          </div>

          <nav class="ggc-document-nav" aria-label="Galactic Gorilla Corps documents">
            <a href="/ggc">GGC Home</a>
            <a href="/ggc-tou" aria-current={isTerms ? "page" : undefined}>
              Terms of Use
            </a>
            <a
              href="/ggc-privacy-policy"
              aria-current={!isTerms ? "page" : undefined}
            >
              Privacy Policy
            </a>
          </nav>
        </div>
      </header>

      <section class="ggc-legal-document">
        <article id="legal-content" class="ggc-legal-copy" tabindex="-1">
          <slot />
        </article>
      </section>
    </main>

    <Footer />
  </body>
</html>
