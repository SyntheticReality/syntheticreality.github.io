---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    productName?: string;
    heading?: string;
  };
}

const { frontmatter } = Astro.props;
const {
  title = "Privacy Policy",
  description = "Privacy and data-use information for OSYRYS services.",
  productName = "Galactic Gorilla Corps",
  heading = "Privacy Policy",
} = frontmatter;

const isTerms = Astro.url.pathname.includes("ggc-tou");
const siteLinks = [
  { href: "/enterprise/", label: "Enterprise" },
  { href: "/entertainment/", label: "Entertainment" },
  { href: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image="/ggc/og.jpg"
      icon="/assets/osyrys-icon.svg"
      colorScheme="dark"
    />
    <meta name="theme-color" content="#08080a" />
    <link
      rel="preload"
      href="/assets/fonts/space-mono-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/refinements.css" />
    <link rel="stylesheet" href="/assets/game-privacy.css" />
    <script is:inline type="module" src="/assets/app.js"></script>
  </head>
  <body class="osyrys-legal">
    <a class="skip-link" href="#legal-content">Skip to legal content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Osyrys home">
        <img src="/assets/osyrys-logo.svg" width="110" height="27" alt="Osyrys" />
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {siteLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <a class="header-contact" href="/contact/">Contact <span aria-hidden="true">↗</span></a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">
        [ Menu <span aria-hidden="true">+</span> ]
      </button>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
        {siteLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
        <a href="/contact/">Contact <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main class="privacy-page">
      <header class="privacy-heading">
        <span class="eyebrow">{productName}</span>
        <h1>{heading}<span class="purple" aria-hidden="true">.</span></h1>
        <nav class="legal-document-nav" aria-label="Galactic Gorilla Corps documents">
          <a href="/ggc-privacy-policy/" aria-current={!isTerms ? "page" : undefined}>Privacy Policy</a>
          <a href="/ggc-tou/" aria-current={isTerms ? "page" : undefined}>Terms of Use</a>
        </nav>
      </header>

      <article id="legal-content" class="privacy-copy" aria-label={heading} tabindex="-1">
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* BaseHead also loads the legacy Astro theme. */
  @media screen {
    .osyrys-legal {
      --muted: #a9a5b0;
      background: var(--bg);
      color: var(--text);
    }
  }

  .privacy-copy > :global(p:first-child) {
    font-size: 13px;
    margin-bottom: 32px;
  }

  .privacy-copy > :global(ul) {
    list-style: disc outside;
  }

  .privacy-copy > :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: clamp(28px, 5vw, 42px) 0 24px;
  }
</style>
