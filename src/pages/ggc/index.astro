---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/ggc.css";

const title = "Galactic Gorilla Corps | Co-op VR Action";
const description =
  "Join the Corps and fight the Arachnids in a co-op VR action game in development for Meta Quest.";

const features = [
  {
    number: "01",
    title: "Build your loadout.",
    description:
      "Choose the weapons and equipment you need before deploying from Silverback Station.",
  },
  {
    number: "02",
    title: "Rise through the ranks.",
    description:
      "Complete missions against the Arachnids and advance your Corps career.",
  },
  {
    number: "03",
    title: "Complete the mission together.",
    description:
      "Run, climb, leap, and boost with physical arm-driven locomotion. Strong arms. Stronger squad.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image="/ggc/og.jpg"
      colorScheme="dark"
    />
    <meta name="theme-color" content="#03090f" />
    <link
      rel="preload"
      href="/fonts/ggc/Oxanium.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/webp" href="/ggc/icon.webp" />
  </head>
  <body class="min-h-screen antialiased">
    <Header />

    <main class="ggc-theme">
      <section class="ggc-art-hero" aria-label="Galactic Gorilla Corps">
        <picture class="ggc-art-hero__picture">
          <source media="(max-width: 700px)" srcset="/ggc/portrait.webp" />
          <img
            src="/ggc/hero.webp"
            width="2400"
            height="720"
            alt="Galactic Gorilla Corps soldiers surrounded by alien Arachnids"
            fetchpriority="high"
          />
        </picture>

        <div class="ggc-art-hero__grid" aria-hidden="true"></div>
      </section>

      <section class="ggc-intro" aria-labelledby="ggc-title">
        <div class="ggc-shell ggc-intro__grid">
          <div>
            <h1 id="ggc-title" class="ggc-display">
              <span class="sr-only">Galactic Gorilla Corps: </span>
              <span>Join the Corps.</span>
              <span class="ggc-display__accent">Fight the Arachnids.</span>
            </h1>
          </div>

          <div class="ggc-intro__copy">
            <p>
              Galactic Gorilla Corps is an upcoming co-op VR action game about
              gorilla soldiers preparing for chaotic squad missions against the
              Arachnids.
            </p>
            <p class="ggc-product-promise">
              Build your loadout. Rise through the ranks. Complete the mission
              together.
            </p>

            <div class="ggc-actions">
              <a class="ggc-button ggc-button--primary" href="#briefing">
                Corps briefing
              </a>
              <a class="ggc-button ggc-button--ghost" href="#updates">
                Follow development
              </a>
            </div>
          </div>
        </div>
      </section>

      <section id="briefing" class="ggc-briefing" aria-labelledby="briefing-title">
        <div class="ggc-shell">
          <div class="ggc-briefing__heading">
            <h2 id="briefing-title">Report to Silverback Station.</h2>
          </div>

          <div class="ggc-briefing__grid">
            <div class="ggc-briefing__art">
              <img
                src="/ggc/icon.webp"
                width="512"
                height="512"
                alt="Armored gorilla soldier wearing a horned helmet"
                loading="lazy"
              />
              <span class="ggc-corner-label">Report to Silverback Station</span>
            </div>

            <div class="ggc-feature-list">
              {
                features.map((feature) => (
                  <article class="ggc-feature">
                    <span class="ggc-feature__number" aria-hidden="true">
                      {feature.number}
                    </span>
                    <div>
                      <h3>{feature.title}</h3>
                      <p>{feature.description}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="updates" class="ggc-endcap" aria-labelledby="updates-title">
        <div class="ggc-shell ggc-endcap__content">
          <h2 id="updates-title">Bring your squad home.</h2>
          <p>The Arachnids are spreading. Follow development and report when the Corps calls.</p>

          <div class="ggc-actions ggc-actions--center">
            <a
              class="ggc-button ggc-button--primary"
              href="https://x.com/Syry_io"
              target="_blank"
              rel="noopener noreferrer"
            >
              Follow development
            </a>
          </div>

          <nav class="ggc-legal" aria-label="Galactic Gorilla Corps legal">
            <a href="/ggc-tou">Terms of Use</a>
            <span aria-hidden="true">/</span>
            <a href="/ggc-privacy-policy">Privacy Policy</a>
          </nav>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
