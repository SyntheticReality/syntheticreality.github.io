---
const today = new Date();
---

<footer class="site-footer studio-footer">
  <div class="footer-contact">
    <span>Serving clients worldwide</span>
    <a href="mailto:hello@syry.io">
      hello@syry.io <span aria-hidden="true">↗</span>
    </a>
  </div>

  <span class="footer-copyright">&copy; {today.getFullYear()} Osyrys</span>

  <nav class="footer-social" aria-label="Social media">
    <a
      href="https://www.linkedin.com/company/0syrys/"
      target="_blank"
      rel="noopener noreferrer"
    >
      LinkedIn <span aria-hidden="true">↗</span>
    </a>
    <a
      href="https://medium.com/syry-io"
      target="_blank"
      rel="noopener noreferrer"
    >
      Medium <span aria-hidden="true">↗</span>
    </a>
  </nav>
</footer>

<style>
  @font-face {
    font-family: "OsyrysMono";
    src: url("/assets/fonts/space-mono-regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  .site-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 25px;
    padding: 27px clamp(22px, 3.6vw, 64px);
    border-top: 1px solid #303035;
    background: #08080a;
    color: #a9a5b0;
    font-family: "OsyrysMono", "Courier New", monospace;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .footer-contact,
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 14px;
    color: #f4f1f7;
  }

  .footer-contact {
    grid-column: 1;
    grid-row: 1;
    gap: 12px;
  }

  .footer-contact > span {
    color: #a9a5b0;
    font-size: 13px;
  }

  .footer-copyright {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    text-align: center;
    white-space: nowrap;
  }

  .footer-social {
    grid-column: 3;
    grid-row: 1;
    justify-content: flex-end;
    gap: 22px;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover,
  a span {
    color: #be95ff;
  }

  a:focus-visible {
    outline: 2px solid #be95ff;
    outline-offset: 7px;
  }

  @media (max-width: 700px) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .footer-contact,
    .footer-social {
      grid-column: 1;
      justify-content: center;
      text-align: center;
    }

    .footer-copyright {
      grid-column: 1;
      grid-row: 2;
    }

    .footer-social {
      grid-row: 3;
    }
  }
</style>
